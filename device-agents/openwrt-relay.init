#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/bin/node /root/relay-agent.mjs
  procd_set_param env CONTROLLER_HOST=192.168.50.10
  procd_set_param env RELAY_MQTT_PORT=1883
  procd_set_param env RELAY_WEB_PORT=8787
  procd_set_param env DEVICE_TOKEN=change-this-before-field-deployment
  procd_set_param respawn 5 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
