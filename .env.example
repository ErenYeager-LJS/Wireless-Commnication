PORT=8787
MQTT_PORT=1883
DEMO_MODE=true
DEVICE_TOKEN=change-this-before-field-deployment
OFFLINE_TIMEOUT_MS=5000
DEGRADED_RTT_MS=120
DEGRADED_LOSS_PERCENT=5
# ESP32-P4 / OV5647 integration (the dedicated launcher sets this automatically)
PLATFORM_BACKEND=mqtt
ESP_RECEIVER_URL=http://127.0.0.1:8080
# Cloud only: use deploy/Install-Cloud.ps1; never commit the private JSON.
# CLOUD_CONFIG=/absolute/path/to/deploy/private/cloud.json
